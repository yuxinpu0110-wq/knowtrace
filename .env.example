# 知溯KnowTrace 交付版 · 环境变量示例
#
# 全部可选。不建这个文件也能跑：默认值就是「本地演示模式」，
# 不需要 Python、不需要 DeepSeek Key、不需要联网。
#
# 若要启用，把本文件复制为 .env；启动器检测到它会用 `node --env-file=.env` 加载
# （该参数需要 Node 20.6+；本包建议 Node 18+，用 Node 18 时请改用系统环境变量）。
# 也可以什么都不做，直接设为系统环境变量。

# ── 服务 ──
# 监听端口。被占用时会自动 +1 重试（最多 10 次），控制台会打印实际地址。
PORT=3001
# 只监听本机（默认监听全部网卡）。开隧道做公网演示时保持默认即可。
# HOST=127.0.0.1
# 接口模拟延迟（毫秒），用于观察加载态。
MOCK_DELAY_MS=250
# 设为 0 可关闭前端静态托管（只提供 /api，回到前后端分离的开发形态）。
# KT_SERVE_WEB=0
# 设为 0 关闭端口自动递增 / 关闭自动开浏览器。
# KT_AUTO_PORT=0
# KT_OPEN_BROWSER=0

# ── DeepSeek（可选；不填则全部走内置 Mock，演示完全可用） ──
# 推荐不写在这里，而是启动后在界面左下角 ⚙️ 里填：那样只存后端内存，
# 不落盘、不回传浏览器；重启后端即失效。
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash

# ── 数据目录（默认 backend/data，首次启动自动生成 7 个演示账号） ──
# KT_DATA_DIR=
